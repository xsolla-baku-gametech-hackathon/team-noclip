# Copy this file to .env (same folder) and fill in the values below.
# .env is gitignored — it will never be committed, even though this example file is.
#
# IMPORTANT: the OpenRouter API key does NOT go here. It's never stored in
# this desktop app or shipped inside the .exe — it lives only as a Vercel
# Environment Variable on the website's deployment (see website/api/recap.js).
# That's what keeps it out of anyone's hands who runs or decompiles the .exe.

# Your deployed website's recap endpoint, e.g. https://your-app.vercel.app/api/recap
RECAP_API_URL=

# Where the tray icon's "Login" button opens in the browser.
WEBSITE_LOGIN_URL=http://localhost:5183/login
