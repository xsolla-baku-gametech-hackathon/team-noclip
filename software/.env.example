# Copy this file to .env (same folder) and fill in the values below.
# .env is gitignored — it will never be committed, even though this example file is.
#
# IMPORTANT: Cloud recap service credentials live as environment variables
# on your deployment (e.g. Vercel) — they are never stored in the desktop app
# or shipped inside the .exe binary.

# Your deployed website's recap endpoint
RECAP_API_URL=https://team-noclip.vercel.app/api/recap

# Where the login button opens in the browser.
WEBSITE_LOGIN_URL=https://team-noclip.vercel.app/login

# Base origin of the deployed website, e.g. https://your-app.vercel.app
# Used for syncing sessions and media to your account after login.
# Requires a database configured on the website side (see website/.env.example).
WEBSITE_API_URL=https://team-noclip.vercel.app
