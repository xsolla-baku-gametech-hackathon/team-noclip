# Copy this file to .env.local (same folder) for local dev, and set the
# same values as Vercel Environment Variables in the project dashboard for
# production. .env.local is gitignored — it will never be committed.

# --- Google Sign-In (public client id, safe to expose) ---------------------
# Create at https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID, type "Web application". Add Authorized JavaScript
# origins for both http://localhost:5183 and your deployed Vercel domain.
VITE_GOOGLE_CLIENT_ID=

# --- OpenRouter (secret — server-side only, read by api/*.js) --------------
# Powers session recap generation. Never expose this to the client.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Database (secret — server-side only) -----------------------------------
# Provision from the Vercel dashboard: Project -> Storage -> Create Database
# -> Postgres. Vercel injects this automatically once connected; only needed
# here for local dev against the same database.
DATABASE_URL=

# --- Session signing secret (secret — invent a long random string) ---------
# Used to sign the web session cookie and is not an external credential —
# generate one yourself, e.g.: openssl rand -hex 32
SESSION_SECRET=
